# Generate secrets: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Only exact hostnames; no wildcard. Feed validation remains required.
ALLOWED_HOSTS=
COLLECTION_INTERVAL=900
# For HTTPS replace :80 with your domain, e.g. watch.example.mn
SITE_ADDRESS=:80
