# Generate secrets: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Extra exact hostnames beyond the bundled 100-site directory. No wildcards.
# Feed validation and rights review remain required.
ALLOWED_HOSTS=
COLLECTION_INTERVAL=900
# For HTTPS replace :80 with your domain, e.g. watch.example.mn
SITE_ADDRESS=:80

# Local-only inference. Download models with sh ops/ai-setup.sh first.
AI_ENABLED=false
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3
AI_BATCH_SIZE=10
AI_TIMEOUT=90
WORKER_TICK_SECONDS=60
RETENTION_DAYS=90
BACKUP_INTERVAL_SECONDS=86400
